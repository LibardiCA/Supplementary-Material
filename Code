Date: [28/09/2025]
===============================================================================
import matplotlib.pyplot as plt
import pandas as pd
import matplotlib.colors as mcolors
from tkinter import Tk, filedialog
from matplotlib.ticker import PercentFormatter

def adjust_color(hex_color, tone_factor=1.0, alpha=1.0):
    """
    Adjust the tone (brightness) and transparency (alpha) of a given hex color.

    Parameters:
    - hex_color (str): Hexadecimal color code (e.g., '#000000').
    - tone_factor (float): Factor to adjust the brightness. Values >1 lighten, values <1 darken.
    - alpha (float): Transparency level (0 = fully transparent, 1 = fully opaque).

    Returns:
    - tuple: RGBA color suitable for matplotlib.
    """
    rgb = mcolors.to_rgb(hex_color)  # Convert hex to RGB tuple
    if tone_factor > 1:
        # Lighten the color
        adjusted_rgb = [1 - (1 - c) / tone_factor for c in rgb]
    else:
        # Darken the color
        adjusted_rgb = [c * tone_factor for c in rgb]
    return (*adjusted_rgb, alpha)  # Return as RGBA tuple

def generate_stacked_bar_chart(tone_factor=1.0, alpha=1.0):
    """
    Generate a stacked bar chart representing the percentage distribution
    of study participants and authors by sex/gender categories.

    Parameters:
    - tone_factor (float): Adjusts brightness of bar colors.
    - alpha (float): Adjusts transparency of bar colors.

    Outputs:
    - Displays the figure.
    - Saves the figure in JPEG, TIFF, and EPS formats via a file dialog.
    """
    # --- Absolute counts of each category ---
    participants_f, participants_m, participants_fm = 62, 407, 95
    first_author_f, first_author_m, first_author_fm = 86, 477, 0
    last_author_f, last_author_m, last_author_fm = 51, 510, 0

    # Organize data into a dictionary for DataFrame creation
    data = {
        'Sex of participants': [participants_f, participants_m, participants_fm],
        'Author gender/sex (first)': [first_author_f, first_author_m, first_author_fm],
        'Author gender/sex (last)': [last_author_f, last_author_m, last_author_fm]
    }

    # Define the categorical labels
    categories = ['Female', 'Male', 'Female and Male']

    # Create a pandas DataFrame with categorical index
    df = pd.DataFrame(data, index=categories)

    # Convert absolute counts to percentages for visualization
    df_percent = df.div(df.sum(axis=0), axis=1) * 100

    # --- Define base colors for bars ---
    base_colors = ['#000000', '#c0c0c0', '#808080']  # Black, light gray, medium gray
    # Adjust colors according to tone_factor and transparency
    colors = [adjust_color(c, tone_factor, alpha) for c in base_colors]

    # --- Initialize figure and axes ---
    fig, ax = plt.subplots(figsize=(8, 6))  # Width x Height in inches
    bottom = [0] * len(df_percent.columns)  # Initial bottom for stacking bars

    # --- Draw stacked bars for each category ---
    for category, color, base_color in zip(df_percent.index, colors, base_colors):
        values = df_percent.loc[category]  # Extract percentage values for current category
        bars = ax.bar(
            df_percent.columns,      # X-axis labels
            values,                  # Heights of bars
            bottom=bottom,           # Stack on top of previous bars
            label=category,          # Legend label
            color=color,             # Fill color
            edgecolor='black',       # Bar border color
            width=0.9                # Bar width
        )
        # Update bottom for stacking
        bottom = [i + j for i, j in zip(bottom, values)]

        # --- Determine text color based on bar brightness ---
        brightness = sum(mcolors.to_rgb(base_color)) / 3
        text_color = 'white' if brightness < 0.4 else 'black'

        # Add text labels inside each bar
        for bar, value in zip(bars, values):
            if value > 0:
                ax.text(
                    bar.get_x() + bar.get_width() / 2,  # Horizontal center
                    bar.get_y() + bar.get_height() / 2, # Vertical center
                    f'{value:.1f}%',                    # Text content
                    ha='center',                        # Horizontal alignment
                    va='center',                        # Vertical alignment
                    fontsize=14,
                    color=text_color
                )

    # --- Configure axes and labels ---
    ax.set_ylim(0, 100)  # Set Y-axis limit from 0% to 100%
    ax.yaxis.set_major_formatter(PercentFormatter(xmax=100, decimals=0))  # Y-axis with % symbol
    ax.tick_params(axis='x', which='both', top=False, bottom=True, length=3)  # Customize ticks
    ax.set_ylabel('')  # Optional: Remove Y-axis label
    ax.set_xlabel('')  # Optional: Remove X-axis label

    # --- Set title for the chart ---
    ax.set_title('Distribution of Participants and Authors by Gender/Sex', fontsize=16, pad=15)

    # --- Configure horizontal legend (side-by-side, right-to-left order) ---
    handles, labels = ax.get_legend_handles_labels()
    ax.legend(
        loc='lower center',            # Place legend below the chart
        bbox_to_anchor=(0.5, -0.12),  # Position adjustment
        frameon=False,                 # Remove legend border
        fontsize=10,
        ncol=3                         # Three columns → labels side by side
    )

    plt.tight_layout()  # Adjust layout to prevent clipping
    plt.show()          # Display the figure

    # --- Save the figure using a file dialog ---
    root = Tk()
    root.withdraw()  # Hide the main tkinter window
    file_path = filedialog.asksaveasfilename(
        defaultextension=".jpg",
        filetypes=[
            ("JPEG files", "*.jpg"),
            ("TIFF files", "*.tiff"),
            ("EPS files", "*.eps"),
            ("All files", "*.*")
        ],
        title="Save the figure"
    )

    # If user provides a file path, save figure in multiple formats
    if file_path:
        fig.savefig(file_path.rsplit('.', 1)[0] + '.jpg', dpi=600, format='jpg', bbox_inches='tight')
        fig.savefig(file_path.rsplit('.', 1)[0] + '.tiff', dpi=600, format='tiff', bbox_inches='tight')
        fig.savefig(file_path.rsplit('.', 1)[0] + '.eps', dpi=600, format='eps', bbox_inches='tight')
        print(f"Saved: {file_path.rsplit('.', 1)[0] + '.jpg'}, "
              f"{file_path.rsplit('.', 1)[0] + '.tiff'}, "
              f"{file_path.rsplit('.', 1)[0] + '.eps'}")

# --- Execute the function with customized tone and transparency ---
generate_stacked_bar_chart(tone_factor=0.9, alpha=0.85)



