"""
===============================================================================
Association Matrix Visualization of Study Variables
===============================================================================

This Python script generates a color-coded matrix to visualize the associations 
between study variables, including participant sex, author sex (first and last), 
muscle biopsy usage, molecular analyses, and publication century.

Features:
- Displays Chi-square (χ²), p-value, and Cramer's V for each association.
- Color intensity reflects the magnitude of the Chi-square statistic.
- Text labels are centered within each cell for clarity.
- Includes a colorbar representing the strength of association.
- Axes and ticks are adjusted for clear visualization.

Author: [DA Silva, DG]
Date: [28/09/2025]
===============================================================================
"""

import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np
from matplotlib import cm

# --- Input Data ---
data = {
    "Association": [
        "1st Author Sex × Participant Sex",
        "Last Author Sex × Participant Sex",
        "Participant Sex × Muscle Biopsy",
        "Participant Sex × Molecular Analyses",
        "Participant Sex × Publication Century"
    ],
    "Chi-square (χ²)": [5.86, 0.47, 1.78, 9.45, 1.41],
    "p-value": [0.119, 0.793, 0.410, 0.009, 0.495],
    "Cramer’s V": [0.10, 0.03, 0.056, 0.13, 0.05]
}

# Convert the dictionary to a pandas DataFrame
df = pd.DataFrame(data)

# --- Normalize Chi-square values for color mapping ---
chi_values = df["Chi-square (χ²)"].values
norm = plt.Normalize(vmin=min(chi_values), vmax=max(chi_values))  # Normalization for colormap
cmap = cm.coolwarm  # Choose a diverging colormap

# --- Create figure and axes ---
fig, ax = plt.subplots(figsize=(6.5, 4.2))  # Width x Height in inches

# Determine number of rows and columns for the matrix
n_rows = df.shape[0]          # Number of associations
n_cols = df.shape[1] - 1      # Exclude the 'Association' column

# --- Draw colored cells for each matrix element ---
for i in range(n_rows):
    # Map the Chi-square value to a color
    color = cmap(norm(df["Chi-square (χ²)"].iloc[i]))
    for j in range(n_cols):
        # Draw a rectangle representing the cell
        rect = plt.Rectangle((j, i), 1, 1, facecolor=color, edgecolor='black')
        ax.add_patch(rect)

        # Add text inside the cell
        if j == 0:
            text = f"{df['Chi-square (χ²)'].iloc[i]:.2f}"
        elif j == 1:
            text = f"{df['p-value'].iloc[i]:.3f}"
        else:
            text = f"{df['Cramer’s V'].iloc[i]:.3f}"

        ax.text(j + 0.5, i + 0.5, text, ha='center', va='center', color='black')

# --- Configure axes limits and labels ---
ax.set_xlim(0, n_cols)
ax.set_ylim(0, n_rows)
ax.invert_yaxis()  # Invert Y-axis to have the first row on top
ax.set_xticks([0.5, 1.5, 2.5])  # Set X-ticks at the center of each column
ax.set_xticklabels(["Chi-square (χ²)", "p-value", "Cramer's V"], rotation=0, ha='center')
ax.set_yticks(np.arange(n_rows) + 0.5)
ax.set_yticklabels(df["Association"])
ax.tick_params(axis='both', length=0)  # Remove tick marks for cleaner look

# --- Add a colorbar indicating association strength ---
sm = cm.ScalarMappable(cmap=cmap, norm=norm)
sm.set_array([])  # Required for matplotlib <3.1
cbar = fig.colorbar(sm, ax=ax, fraction=0.05, pad=0.03)
cbar.set_label('Association Strength', fontsize=12)

# --- Set title for the matrix ---
ax.set_title('Visualization of Associations between Study Variables', fontsize=14, pad=12)

plt.tight_layout()  # Adjust layout to prevent clipping
plt.show()          # Display the figure



